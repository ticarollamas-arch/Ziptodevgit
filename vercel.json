{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "github-app": {
      "root": "artifacts/github-intelligence",
      "framework": "vite",
      "buildCommand": "BASE_PATH=/ PORT=3000 pnpm --dir ../.. --filter @workspace/github-intelligence build",
      "outputDirectory": "dist/public"
    },
    "api": {
      "root": "artifacts/api-server",
      "runtime": "node",
      "buildCommand": "pnpm --dir ../.. --filter @workspace/api-server build",
      "entrypoint": "dist/index.mjs"
    },
    "mockups": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "buildCommand": "BASE_PATH=/mockups/ PORT=3000 pnpm --dir ../.. --filter @workspace/mockup-sandbox build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/mockups/(.*)",
      "destination": {
        "service": "mockups"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "github-app"
      }
    }
  ]
}
